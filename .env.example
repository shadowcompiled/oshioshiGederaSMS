# Required in production
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Admin dashboard password (REQUIRED in production — the app refuses a default there)
ADMIN_PASSWORD=admin

# Waiter account (single restricted login for the waiter screen at /waiter).
# Both must be set or waiter login is disabled entirely.
WAITER_USERNAME=
WAITER_PASSWORD=

# Database: use Postgres on Vercel (or omit for local SQLite)
# POSTGRES_URL=postgres://user:pass@host:5432/dbname?sslmode=require
# DATABASE_URL=postgres://...

# Master switch for SMS signup verification.
#   false / unset -> customers join straight from the form (pre-2FA behaviour)
#   true          -> a code is texted and must be entered before joining
# Turn it on only when the SMS gateway is known to be up: with it on and the
# gateway unreachable, nobody can join the club.
# Vercel injects env vars at deploy time, so redeploy after changing this.
REQUIRE_PHONE_VERIFICATION=false

# SMS Gateway (Android SMS Gateway app).
# REQUIRED in production: signup is gated behind an SMS verification code, so
# without a working gateway nobody can join the club. Locally, if these are
# unset, /api/signup/start returns the code in the response (and logs it) so the
# flow stays testable; that only ever happens when NODE_ENV is not production.
# All SMS goes through 019 (lib/sms-gateway.ts). SMS_019_SOURCE is the
# registered alphanumeric sender (1-11 English letters/digits/spaces).
# Set SMS_019_API_URL=https://019sms.co.il/api/test to validate without sending.
SMS_019_TOKEN=
SMS_019_USERNAME=
SMS_019_SOURCE=OSHI GEDERA
# SMS_019_API_URL=

# Inbound unsubscribe-by-SMS (for feature phones that can't tap the link).
# Register an `sms:received` webhook in the SMS Gateway pointing to
# https://your-app/api/sms/incoming, signed with this shared secret.
SMS_WEBHOOK_SECRET=
# Keyword a customer texts back to unsubscribe (default: 1111).
# UNSUBSCRIBE_KEYWORD=1111

# QStash for queuing broadcast/birthday SMS
QSTASH_TOKEN=
# Set QSTASH_URL only for the EU region, e.g. https://eu1-xxxx.upstash.io
# QSTASH_URL=

# Upstash Redis for distributed rate limiting (recommended in production).
# Without these, rate limiting falls back to per-instance in-memory (fine for local dev).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public base URL used for unsubscribe links / QStash callback when the
# request origin is unavailable. e.g. https://your-app.vercel.app
# APP_URL=

# Cron: protect birthday check endpoint
CRON_SECRET=YOUR_LONG_CRON_SECRET

# Vercel sets this automatically
# VERCEL_URL=

# Optional: shown as action buttons on the signup success screen (hidden when unset).
# NEXT_PUBLIC_BUSINESS_PHONE: tel: link target, e.g. +97288591234
# NEXT_PUBLIC_WHATSAPP_PHONE: wa.me number, digits only with country code, e.g. 972501234567
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_PHONE=
